# Copy to .env.local for local dev; set the same values in
# Cloudflare Pages → Settings → Environment variables for production.

# Canonical public address (custom domain, no trailing slash)
NEXT_PUBLIC_SITE_URL=https://radhakrishnadigital.com

# Headline contact email — switch to the domain email once it exists
NEXT_PUBLIC_CONTACT_EMAIL=charank.freelance@gmail.com

# WhatsApp Business number, digits only with country code (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Free key from https://web3forms.com (enter the email that should receive enquiries).
# Without it, the form opens the visitor's email app pre-filled instead.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional privacy-respecting analytics (Plausible). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
