/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

# Share preview generated by Next.js has no file extension.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400

# Per-deploy preview addresses (abc123.radhakrishna-digital.pages.dev) stay out of search.
# The main radhakrishna-digital.pages.dev address IS indexed until a custom domain is live;
# then add a noindex block for it (or a Bulk Redirect) so only the domain is indexed.
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
